{
  "name": "vsc-community-material-theme",
  "displayName": "Community Material Theme",
  "description": "The official community maintained Material Theme with 'legacy' color schemes you love!",
  "version": "1.4.4",
  "publisher": "Equinusocio",
  "license": "Apache-2.0",
  "author": "Mattia Astorino [@equinusocio]",
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#11131C",
    "theme": "dark"
  },
  "homepage": "https://material-theme.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/material-theme/vsc-community-material-theme.git"
  },
  "bugs": {
    "url": "https://github.com/material-theme/vsc-community-material-theme/issues"
  },
  "engines": {
    "node": "<=10",
    "vscode": "^1.41.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "VSCode",
    "Themes"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Community Material Theme",
        "path": "./themes/Community-Material-Theme-Default.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme High Contrast",
        "path": "./themes/Community-Material-Theme-Default-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme Darker",
        "path": "./themes/Community-Material-Theme-Darker.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme Darker High Contrast",
        "path": "./themes/Community-Material-Theme-Darker-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme Palenight",
        "path": "./themes/Community-Material-Theme-Palenight.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme Palenight High Contrast",
        "path": "./themes/Community-Material-Theme-Palenight-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme Ocean",
        "path": "./themes/Community-Material-Theme-Ocean.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme Ocean High Contrast",
        "path": "./themes/Community-Material-Theme-Ocean-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Community Material Theme Lighter",
        "path": "./themes/Community-Material-Theme-Lighter.json",
        "uiTheme": "vs"
      },
      {
        "label": "Community Material Theme Lighter High Contrast",
        "path": "./themes/Community-Material-Theme-Lighter-High-Contrast.json",
        "uiTheme": "vs"
      }
    ]
  }
}
